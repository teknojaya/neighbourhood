# Backend environment (apps/api). Copy to apps/api/.env for local development.
# PLACEHOLDERS ONLY. Never commit .env. Never put these values in VITE_ variables.

NODE_ENV=development
PORT=8080

# --- PostgreSQL ----------------------------------------------------------------
# Local: `npm run db:up` starts Postgres 17 on 127.0.0.1:55432 (docker-compose.yml).
# Cloud SQL (Cloud Run): postgresql://USER:PASSWORD@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://neighbourhood:neighbourhood_local@127.0.0.1:55432/neighbourhood?schema=public
TEST_DATABASE_URL=postgresql://neighbourhood:neighbourhood_local@127.0.0.1:55432/neighbourhood_test?schema=public

# --- Firebase (Authentication, Cloud Messaging, Cloud Storage) -----------------
# Admin credentials: Application Default Credentials (gcloud auth application-default login)
# or the Cloud Run service account. Required to verify tokens (revocation check)
# and to mint custom tokens for email OTP. Never commit service-account JSON.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Shared across all deployed API instances; at least 32 random characters.
# Leave empty only for single-process local development (URLs reset on restart).
STORAGE_SIGNING_SECRET=
# Enable only with real Firebase Messaging credentials; no FCM emulator exists.
PUSH_ENABLED=false

# Optional local emulators (Storage requires Java 21+). Requires a demo-* project id;
# refused in production / Cloud Run.
USE_FIREBASE_EMULATORS=false
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Gemini (server-side only) ------------------------------------------------
# Leave empty to run with AI shown as "unavailable" (no canned responses).
GEMINI_API_KEY=
# Model id from https://ai.google.dev/gemini-api/docs/models (verified 2026-10-17).
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Email OTP (server-side only) ---------------------------------------------
# Until ALL of these are set, email-code sign-in reports "not configured".
# OTP_SECRET: random string >= 32 chars, e.g. `openssl rand -base64 48`.
OTP_SECRET=
# Any SMTP relay with TLS (e.g. Google Workspace smtp-relay.gmail.com, or a
# transactional email provider's SMTP endpoint). 587 = STARTTLS, 465 = TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A sender address your relay is authorised to send as (SPF/DKIM configured).
EMAIL_FROM=
