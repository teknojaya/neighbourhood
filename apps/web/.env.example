# Frontend environment (apps/web). PUBLIC Firebase web-app identifiers only
# (Firebase console → Project settings → Your apps). PLACEHOLDERS ONLY.
# Server secrets (GEMINI_API_KEY, OTP_SECRET, SMTP_*) must never appear here —
# the build refuses secret-like VITE_ names.
#
# Local development: copy to apps/web/.env.development.local
# Production build:  copy to apps/web/.env.production.local (or Docker build args)

VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Optional local Auth emulator (dev server on localhost only; production builds fail if true).
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
